context:
  version: "__VIPP_VERSION__"
  python_min: "3.12"
  build_number: 0

recipe:
  name: napari-vipp
  version: ${{ version }}

source:
  - path: source

build:
  number: ${{ build_number }}

outputs:
  - package:
      name: napari-vipp
    build:
      noarch: python
      python:
        entry_points:
          - vipp = napari_vipp.__main__:main
          - vipp-app = napari_vipp.launcher:main_auto
          - vipp-compute-doctor = napari_vipp.core.compute_diagnostics:main
          - vipp-cpu = napari_vipp.launcher:main_cpu
          - vipp-install-plan = napari_vipp.installer.cli:main
          - vipp-prefer-gpu = napari_vipp.launcher:main_prefer_gpu
      script:
        - test "$(shasum -a 256 "${SRC_DIR}/__VIPP_WHEEL_FILENAME__" | awk '{print $1}')" = "__VIPP_WHEEL_SHA256__"
        - ${PYTHON} -m pip install "${SRC_DIR}/__VIPP_WHEEL_FILENAME__" --no-index --no-deps --no-build-isolation -vv
        - rm -f "${SP_DIR}/napari_vipp-__VIPP_VERSION__.dist-info/direct_url.json"
    requirements:
      host:
        - python ${{ python_min }}.*
        - pip
      run:
        - python >=3.12,<3.14
        - dask-core >=2025.2
        - fsspec >=2024.2
        - imageio >=2.31
        - numpy >=1.24
        - ome-types >=0.6
        - ome-zarr >=0.17
        - pillow >=10
        - qtpy >=2.4
        - scikit-image >=0.21
        - scipy >=1.10
        - tifffile >=2023.8
        - zarr >=3.0
        - napari >=0.6
    tests:
      - python:
          imports:
            - napari_vipp
          python_version:
            - ${{ python_min }}.*
      - script:
          - vipp --version
    about:
      homepage: https://github.com/rensutheart/napari-vipp
      repository: https://github.com/rensutheart/napari-vipp
      documentation: https://rensutheart.github.io/vipp-mkdocs/
      summary: Visual image processing made approachable
      license: BSD-3-Clause
      license_file: source/LICENSE

  - package:
      name: vipp-menu
    build:
      noarch: python
      script:
        - mkdir -p "${PREFIX}/Menu"
        - cp "${SRC_DIR}/vipp-menu.json" "${PREFIX}/Menu/vipp-menu.json"
        - cp "${SRC_DIR}/vipp.icns" "${PREFIX}/Menu/vipp.icns"
    requirements:
      host:
        - python ${{ python_min }}.*
      run:
        - python >=3.12,<3.14
        - menuinst >=2.5,<3
        - ${{ pin_subpackage('napari-vipp', exact=True) }}
    tests:
      - package_contents:
          files:
            - Menu/vipp-menu.json
            - Menu/vipp.icns
    about:
      homepage: https://github.com/rensutheart/napari-vipp
      repository: https://github.com/rensutheart/napari-vipp
      summary: macOS application shortcut for VIPP
      license: BSD-3-Clause
      license_file: source/LICENSE

about:
  homepage: https://github.com/rensutheart/napari-vipp
  repository: https://github.com/rensutheart/napari-vipp
  summary: Visual image processing made approachable
  license: BSD-3-Clause
  license_file: source/LICENSE
