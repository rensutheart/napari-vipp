        "recipe_version": 1,
        "plot_type": "Scatter",
        "y_column": "skeleton_length_physical",
        "x_column": "volume_physical",
        "group_column": "",
        "point_unit": "Objects",
        "image_column": "image_id",
        "summary": "Median",
        "distribution": "Histogram",
        "bins": 16,
        "normalization": "Count",
        "log_x": false,
        "log_y": false,
        "title": "Object volume and its own skeleton length",
        "point_size": 7,
        "show_grid": true
