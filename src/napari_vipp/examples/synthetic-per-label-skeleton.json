        "spatial_mode": "3D ZYX",
        "method": "Auto"
      }
    },
    {
      "id": "merged",
      "operation_id": "merge_tables",
      "params": {
        "input_count": 2,
        "join_mode": "Left join",
        "join_keys": "label_id"
      }
    },
    {
      "id": "annotated",
      "operation_id": "add_metadata_columns",
