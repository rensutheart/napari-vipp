{
  "type": "napari-vipp-workflow",
  "version": 6,
  "execution": {
    "compute": {
      "mode": "cpu",
      "fallback_policy": "visible",
      "node_preferences": {},
      "precision_policy": "scientific-default-v1",
      "workload_policy": "vipp-best-available-v1"
    }
  },
  "metadata": {
    "vipp": {
      "node_names": {
        "input": "Red channel",
        "image_b": "Green channel",
        "review": "Review Images"
