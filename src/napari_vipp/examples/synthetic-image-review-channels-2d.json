              "colormap": "red",
              "lock_contrast": false,
              "opacity": 1,
              "visible": true,
              "mask_color": "#00FF66",
              "threshold": null
            },
            "b": {
              "contrast_limits": [
                0,
                1
              ],
              "colormap": "green",
              "lock_contrast": false,
              "opacity": 1,
              "visible": true,
              "mask_color": "#00FF66",
              "threshold": null
            }
          }
        }
      }
    }
